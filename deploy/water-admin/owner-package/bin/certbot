#!/usr/bin/env bash
set -Eeuo pipefail

REAL_CERTBOT="${BB610_REAL_CERTBOT:-}"
[ -n "$REAL_CERTBOT" ] || { echo 'BB610 certbot gate: BB610_REAL_CERTBOT is not set' >&2; exit 91; }
[ -x "$REAL_CERTBOT" ] || { echo "BB610 certbot gate: real certbot is not executable: $REAL_CERTBOT" >&2; exit 92; }

# Non-issuance calls used by preflight must behave exactly like the real binary.
case " ${*:-} " in
  *' --version '*) exec "$REAL_CERTBOT" "$@" ;;
esac

WEBROOT=""
IS_WEBROOT_CERTONLY=0
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  case "${args[$i]}" in
    certonly) IS_WEBROOT_CERTONLY=1 ;;
    --webroot) : ;;
    -w|--webroot-path)
      if (( i + 1 < ${#args[@]} )); then WEBROOT="${args[$((i+1))]}"; fi
      ;;
  esac
done

if [ "$IS_WEBROOT_CERTONLY" -eq 1 ] && [ -n "$WEBROOT" ]; then
  ADMIN_DOMAIN="${BB610_ADMIN_DOMAIN:-admin.water.bb610.com.ua}"
  API_DOMAIN="${BB610_API_DOMAIN:-api.water.bb610.com.ua}"
  TOKEN="bb610-owner-probe-$(date +%s)-$$-${RANDOM:-0}"
  TOKEN_DIR="$WEBROOT/.well-known/acme-challenge"
  TOKEN_FILE="$TOKEN_DIR/$TOKEN"
  mkdir -p "$TOKEN_DIR"
  printf '%s\n' "$TOKEN" > "$TOKEN_FILE"
  chmod 0644 "$TOKEN_FILE"

  # AlmaLinux/RHEL SELinux: restore the standard /var/www context before Nginx
  # is asked to serve the challenge. This is a no-op on systems without SELinux.
  if command -v restorecon >/dev/null 2>&1; then
    restorecon -RF "$WEBROOT" >/dev/null 2>&1 || {
      rm -f "$TOKEN_FILE"
      echo "BB610 ACME gate: restorecon failed for $WEBROOT" >&2
      exit 93
    }
  fi

  cleanup(){ rm -f "$TOKEN_FILE"; }
  trap cleanup EXIT INT TERM HUP

  probe_exact(){
    local label="$1" url="$2" resolve_arg="${3:-}" body
    if [ -n "$resolve_arg" ]; then
      body="$(curl -fsS --max-time 10 --resolve "$resolve_arg" "$url")" || {
        echo "BB610 ACME gate: $label probe failed: $url" >&2
        return 1
      }
    else
      body="$(curl -fsS --max-time 12 "$url")" || {
        echo "BB610 ACME gate: $label probe failed: $url" >&2
        return 1
      }
    fi
    [ "$body" = "$TOKEN" ] || {
      echo "BB610 ACME gate: $label probe returned unexpected content for $url" >&2
      return 1
    }
  }

  for domain in "$ADMIN_DOMAIN" "$API_DOMAIN"; do
    URL="http://$domain/.well-known/acme-challenge/$TOKEN"
    probe_exact "LOCAL/$domain" "$URL" "$domain:80:127.0.0.1" || exit 94
  done
  for domain in "$ADMIN_DOMAIN" "$API_DOMAIN"; do
    URL="http://$domain/.well-known/acme-challenge/$TOKEN"
    probe_exact "PUBLIC/$domain" "$URL" || exit 95
  done

  echo "BB610 ACME gate PASS: local + public token/200 verified for $ADMIN_DOMAIN and $API_DOMAIN" >&2
fi

exec "$REAL_CERTBOT" "$@"
