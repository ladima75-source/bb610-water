# BB610 WATER Admin production environment template.
# COPY to /etc/bb610-water-admin/admin.env, chmod 600, replace every REPLACE_* value.
# Never commit the real production file.

POSTGRES_DB=bb610_water_admin
POSTGRES_USER=bb610_water_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD

BB610_ADMIN_JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES
BB610_ADMIN_JWT_ISSUER=bb610-water-admin-production
BB610_ADMIN_JWT_TTL_MIN=60
BB610_ADMIN_LOGIN_MAX_FAILURES=5
BB610_ADMIN_LOGIN_BLOCK_MIN=15

# Bootstrap must use the actual named owner/admin email, never a generic shared login.
# After the named account exists and its password is rotated, clear both bootstrap values and restart API.
BB610_ADMIN_BOOTSTRAP_EMAIL=REPLACE_WITH_NAMED_OWNER_EMAIL
BB610_ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_ONE_TIME_STRONG_BOOTSTRAP_PASSWORD

BB610_ADMIN_CORS_ORIGINS=https://admin.water.bb610.com.ua
BB610_ADMIN_API_PORT=18080
BB610_ADMIN_DATA_ROOT=/var/lib/bb610-water-admin
BB610_ADMIN_BACKUP_ROOT=/var/backups/bb610-water-admin
